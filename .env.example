# LLM Provider Configuration (options: openai, gemini, mock)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embedding Provider Configuration (options: local, openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reranker Configuration (options: cross_encoder, dummy)
RERANKER_TYPE=dummy
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage & Retrieval Settings
VECTOR_DB_PATH=data/processed/chroma_db
DATA_CSV_PATH=data/menu.csv
TOP_K=10
RERANK_TOP_K=5
RRF_K=60

# Observability & Logging
LOG_LEVEL=INFO
